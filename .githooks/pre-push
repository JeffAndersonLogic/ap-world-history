#!/bin/sh
#
# Runs the offline suite before anything leaves the machine.
#
# Offline only, deliberately. It finishes in about five seconds, which is the
# difference between a hook you keep and a hook you start bypassing. The browser
# contracts are slower and CI runs them on every push anyway, so this hook's job
# is to catch the structural break before you have to learn about it from a red
# badge.
#
# Installed by `npm run hooks:install`, or automatically by `npm install`, both
# of which set core.hooksPath to this directory.
#
# To push past it once, when you know what you are doing:
#   git push --no-verify

# No node means no checks ran. Say so at full volume rather than in passing: the
# quiet version of this line read like a routine skip, and a push that verified
# nothing is not routine. It still exits 0, because this hook is a convenience
# and CI plus the branch rule are what actually gate main, but nobody should be
# able to read this output and think the suite passed.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found. NOTHING WAS CHECKED." >&2
  echo "pre-push: this push has not run validate.js or any test." >&2
  echo "pre-push: CI will run them; watch the Validate job before you rely on it." >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"

echo "pre-push: running offline checks..."

if ! node "$root/scripts/run-tests.js" offline; then
  echo "" >&2
  echo "pre-push: checks failed, push aborted." >&2
  echo "Fix the failures above, or push with --no-verify to override." >&2
  exit 1
fi

exit 0
