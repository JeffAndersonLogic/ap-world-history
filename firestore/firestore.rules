rules_version = '2';

// BeHistorical student response persistence: the security model.
//
// In Firestore the rules ARE the protection. There is no application server in
// front of this and no second layer behind it, so a wrong line here is not a
// bug, it is every student's writing readable by anyone who can sign in. That
// is why this file is short, why every allow is constrained by identity rather
// than by authentication, and why it is checked twice: offline by
// scripts/check-firestore-rules.js in the push gate, and against the real
// Firestore engine by scripts/test/firestore-rules.test.js.
//
// Phase 2 of the persistence plan in AndersonLogic-OS at
// 04_PRODUCTS/BeHistorical/Student-Response-Persistence-Architecture-2026-09-08.md.
// Nothing in the student-facing site reads or writes any of this yet.
//
// Hardened 2026-09-29 after an external review. See firestore/README.md for what
// that review found and the one recommendation it made that was declined.
//
// THERE IS NO CATCH-ALL DENY IN THIS FILE, DELIBERATELY.
//
// A `match /{document=**} { allow read, write: if false; }` looks like a
// backstop and is not one: Firestore ORs the allow statements of every matching
// rule, so an explicit false cannot veto a true written elsewhere. It would read
// as a safety net while catching nothing. The real default is that anything this
// file does not name is refused, and the offline check enforces that no rule is
// satisfiable by being signed in alone.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ───────────────────────────────────────────────────────────
    //
    // Signed in is necessary and never sufficient. Every allow below also
    // constrains WHICH records, because "any authenticated user" is the shape
    // that turns one student's account into every student's work.

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Defense in depth. Verified district email is the real check; pinning the
    // provider means that enabling another sign-in method later, for some
    // unrelated reason, cannot quietly widen who satisfies the domain test.
    function viaGoogle() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // The tenant a caller belongs to, derived from their verified Workspace
    // email domain rather than from a custom claim.
    //
    // Custom claims would be cleaner and are how this should work eventually.
    // They need a Cloud Function on the auth trigger, and Cloud Functions
    // require the paid plan, which ZCS finance declined on 2026-09-29. Deriving
    // from the domain needs no server and no billing account, and the domain is
    // asserted by Google rather than by us.
    //
    // Two domains, one tenant, added 2026-10-05 on ZCS IT's word that students
    // sign in with their stumail accounts. Staff are zcs.k12.in.us and students
    // are stumail.zcs.k12.in.us. Before this the rule accepted staff only, so every
    // student would have been refused with "tell your teacher" on the first save.
    // It is an exact match on the whole domain after the @, never a suffix test:
    // evilzcs.k12.in.us and stumail.zcs.k12.in.us.evil.com both end in a district
    // name and are neither.
    //
    // Adding a district is one line here. It stays in the rules rather than in a
    // config document because a config document is a read on every request and a
    // second thing to secure.
    function tenantOfCaller() {
      return !viaGoogle() ? ''
        : !(request.auth.token.email is string) ? ''
        : request.auth.token.email_verified != true ? ''
        : request.auth.token.email.lower().split('@')[1] in ['zcs.k12.in.us', 'stumail.zcs.k12.in.us'] ? 'zcs'
        : '';
    }

    function inTenant(tenantId) {
      return tenantOfCaller() != '' && tenantOfCaller() == tenantId;
    }

    // ── Teacher readers ────────────────────────────────────────────────────
    //
    // The two people who may read every student's response in the tenant, for
    // the Curriculum X-Ray (see AndersonLogic-OS, 04_PRODUCTS/BeHistorical/
    // Curriculum-X-Ray-Design-2026-10-08.md).
    //
    // THIS IS A CLOSED LIST OF EXACT ADDRESSES, NOT "STAFF". The staff domain
    // is every teacher, aide and substitute in the district, and a rule that said
    // "staff may read responses" would hand every student's writing to all of
    // them. An address here is a named person and nothing else. It is an exact
    // match on the whole verified address, never a suffix or local-part test:
    // janderson@stumail.zcs.k12.in.us is a student who happens to share a name
    // and is not on this list.
    //
    // The list lives in the rules and not in a database document for the reason
    // the domains do: a document is a read on every request and a second thing
    // to secure. Changing who may read is a one-line edit, a ZCS review and a
    // deploy, which is the right amount of friction for that decision.
    //
    // Mike Kelly is NOT on the list yet because his address has not been
    // supplied. Adding him is one more entry here and one more constant in
    // scripts/test/firestore-rules.test.js. Do not deploy before ZCS has reviewed
    // this access model.
    //
    // Read only. isReader() is used by exactly one allow statement and it grants
    // get and list. A reader cannot create, update or delete, and the emulator
    // test asserts each.
    function isReader() {
      return viaGoogle()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['janderson@zcs.k12.in.us'];
    }

    // ── Student responses ──────────────────────────────────────────────────
    //
    // tenants/{tenantId}/responses/{responseId}, flat, as the architecture
    // record specifies. Two levels of path is what keeps these rules short
    // enough to audit, which is the one thing here that cannot be got wrong.

    match /tenants/{tenantId}/responses/{responseId} {

      // The record already stored belongs to the caller.
      function ownsStored() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      // The record being written names the caller as its author. Checked
      // separately from ownsStored: on a create there is no stored document, and
      // on an update a caller must not be able to reassign a record to someone
      // else or away from themselves.
      function ownsIncoming() {
        return signedIn() && request.resource.data.studentId == request.auth.uid;
      }

      // THE DOCUMENT ID IS DERIVED, NOT CHOSEN, and this is the change the
      // external review mattered most for.
      //
      // Before it, a signed-in student could create unlimited documents by
      // varying responseId, because every create satisfied every other check. A
      // client bug looping on create would have manufactured a new document per
      // iteration: unbounded storage, unbounded writes, and nothing in the rules
      // to notice. Deriving the id from the author, the topic and the slot means
      // one response has exactly one address, so a loop rewrites one document
      // instead of creating millions.
      //
      // This bounds the document COUNT. It does not bound the write RATE; see
      // "the rate limit that is not here" in firestore/README.md for why that is
      // the client's job and the daily quota's, and not this file's.
      function idIsDerived() {
        return responseId == request.auth.uid + '__'
          + request.resource.data.topicKey + '__'
          + request.resource.data.slotId;
      }

      // A response is a fixed shape. hasOnly is what makes this an allowlist
      // rather than a floor: a field nobody designed cannot be smuggled in, and
      // an attacker cannot park arbitrary data in a record that is otherwise
      // valid. Every permitted field is typed and bounded, not just the ones
      // that are required, because an unvalidated optional field is a hole with
      // a smaller sign on it.
      function shapeIsValid() {
        return request.resource.data.keys().hasOnly([
                 'tenantId', 'studentId', 'courseId', 'sectionId', 'topicKey',
                 'slotId', 'text', 'confidence', 'createdAt', 'updatedAt',
                 'clientId', 'schemaVersion'
               ])
            // confidence is REQUIRED and may be the empty string. It used to be
            // optional while the rule read it unconditionally, which in Firestore
            // means a create that omitted it was denied by an evaluation error
            // rather than by a decision. A blank answer is expressed as '', not
            // as an absent key.
            && request.resource.data.keys().hasAll([
                 'tenantId', 'studentId', 'courseId', 'topicKey', 'slotId',
                 'text', 'confidence', 'createdAt', 'updatedAt', 'schemaVersion'
               ])
            // The record cannot lie about where it lives.
            && request.resource.data.tenantId == tenantId
            && request.resource.data.courseId is string
            && request.resource.data.courseId.size() <= 32
            // Bounded shapes rather than an enumerated list of every topic and
            // slot: enumerating would put a second copy of the lesson inventory
            // in the security model, and it would go stale silently.
            && request.resource.data.topicKey is string
            && request.resource.data.topicKey.matches('^[a-z0-9]{1,4}-?[0-9]{0,2}$')
            && request.resource.data.slotId is string
            && request.resource.data.slotId.matches('^[a-z0-9-]{1,64}$')
            && request.resource.data.schemaVersion is int
            // A size ceiling is a cost control as much as an abuse control.
            // Firestore rules count CHARACTERS here, not bytes: String.size() is
            // a character count, so this is 20,000 characters, roughly sixteen
            // times the longest checkpoint answer anyone has written.
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 20000
            // Blank is a real answer and must stay cheap to express.
            && (request.resource.data.confidence == ''
                || (request.resource.data.confidence is int
                    && request.resource.data.confidence >= 1
                    && request.resource.data.confidence <= 5))
            // Timestamps are the server's, never the client's. A client-supplied
            // updatedAt makes the conflict rule guessable and lets a device
            // backdate a write to win a merge it should have lost.
            && request.resource.data.updatedAt == request.time
            && request.resource.data.createdAt is timestamp
            // Optional fields are still validated when present.
            && (!('sectionId' in request.resource.data.keys())
                || (request.resource.data.sectionId is string
                    && request.resource.data.sectionId.size() <= 32))
            && (!('clientId' in request.resource.data.keys())
                || (request.resource.data.clientId is string
                    && request.resource.data.clientId.size() <= 64));
      }

      // What an ordinary edit is allowed to touch. Everything else about a
      // record, who wrote it, which topic and slot it answers, when it was
      // created, is fixed at creation. Without this a student who owns a
      // document could move their Checkpoint 2 answer onto the Map slot, or
      // rewrite its topic, and the record would still pass every other check.
      function onlyMutableFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'confidence', 'updatedAt', 'clientId']);
      }

      // A student reads their own work and nobody else's. Both halves are load
      // bearing: inTenant alone would let one district's student read another
      // student in the same district, and ownsStored alone would let a caller
      // from any domain read a record whose studentId they somehow matched.
      //
      // For `list`, remember that rules are filters' gatekeeper and not filters
      // themselves: a query without an explicit studentId constraint is refused
      // outright rather than silently narrowed. The emulator test asserts both
      // directions.
      allow get, list: if inTenant(tenantId) && ownsStored();

      // A named teacher reads the tenant's responses. Still inTenant, so a
      // reader's reach ends at the district, and still an allow of its own, so
      // the student path above is untouched and cannot be loosened by editing
      // this one. Reads only: nothing here grants a write of any kind.
      allow get, list: if inTenant(tenantId) && isReader();

      allow create: if inTenant(tenantId)
                    && ownsIncoming()
                    && idIsDerived()
                    && shapeIsValid()
                    && request.resource.data.createdAt == request.time;

      // An update must be the author's, before and after. Without ownsIncoming
      // a student could rewrite their own record to carry someone else's
      // studentId and hand it away.
      allow update: if inTenant(tenantId)
                    && ownsStored()
                    && ownsIncoming()
                    && shapeIsValid()
                    && onlyMutableFieldsChanged();

      // Deletion is refused outright, for everyone, including the author.
      //
      // This system exists because student work vanishes. A delete path that a
      // student can reach is one more way for it to vanish, and "I deleted it by
      // accident" is indistinguishable at the database from the failure this
      // project was installed to fix. District retention and deletion are
      // administrative operations run with admin credentials, which bypass these
      // rules by design.
      allow delete: if false;
    }
  }
}
