# Canvas credentials, the template.
#
# THIS file is committed and safe: it holds no real values.
# Copy it to `.env` in this same folder and fill that one in.
# `.env` is gitignored and validate.js fails the build if it ever stops being.
#
#     cp .env.example .env
#
# The token is minted at:
#     Canvas > Account > Settings > Approved Integrations > New Access Token
#     Purpose: BeHistorical course build
#     Expiration: the 90-day maximum
#
# Canvas shows the token exactly once. If you close that dialog without
# copying it, mint another; there is no way to read it back.
#
# Never paste a real token into this file, into a script, into a commit,
# or into a chat window. It grants everything your teacher account can do.

CANVAS_BASE=https://zcs.instructure.com

# The long string from the New Access Token dialog. Looks like 7421~AbCd...
CANVAS_TOKEN=

# From the course URL: .../courses/42956  ->  42956
# Confirm this is the live AP World course before anything writes to it.
CANVAS_COURSE_ID=

# Optional. A sandbox course to build into first, so a bad run never
# reaches students. Strongly recommended before the first real push.
CANVAS_SANDBOX_COURSE_ID=
